rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function shared(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.slug is string;
    }
    function validSlug(slug) {
      return slug is string && slug.size() >= 3 && slug.size() <= 30
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && !(slug in ['www','api','admin','app','auth','login','support','mail']);
    }
    function validPhoto(data) {
      return data.region is string && data.region.size() <= 160 && data.created is int
        && data.get('caption', '') is string && data.get('caption', '').size() <= 240
        && data.get('people', '') is string && data.get('people', '').size() <= 120
        && data.get('date', '') is string && data.get('date', '').matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
        && data.get('coverAt', 0) is int
        && data.get('visibility', 'private') in ['public', 'private'];
    }
    function statsPath(uid) {
      return /databases/$(database)/documents/gallerySocial/$(uid);
    }
    function totals(uid) {
      return exists(statsPath(uid)) ? get(statsPath(uid)).data
        : {'views': 0, 'likes': 0, 'comments': 0, 'lastComment': ''};
    }
    function memberPath(uid, kind) {
      return /databases/$(database)/documents/gallerySocial/$(uid)/$(kind)/$(request.auth.uid);
    }
    function commentPath(uid, id) {
      return /databases/$(database)/documents/gallerySocial/$(uid)/messages/$(id);
    }
    function delta(uid, field, amount) {
      return getAfter(statsPath(uid)).data[field] == totals(uid)[field] + amount;
    }
    function socialAccess(uid) {
      return request.auth != null && shared(uid);
    }
    function validTotals(uid, next) {
      let previous = totals(uid);
      let view = memberPath(uid, 'views');
      let like = memberPath(uid, 'likes');
      return next.keys().hasAll(['views','likes','comments','lastComment'])
        && next.keys().hasOnly(['views','likes','comments','lastComment'])
        && next.views is int && next.likes is int && next.comments is int
        && next.views >= 0 && next.likes >= 0 && next.comments >= 0
        && next.lastComment is string
        && (
          (uid != request.auth.uid && next.diff(previous).affectedKeys().hasOnly(['views'])
            && next.views == previous.views + 1 && !exists(view) && existsAfter(view))
          || (next.diff(previous).affectedKeys().hasOnly(['likes'])
            && ((next.likes == previous.likes + 1 && !exists(like) && existsAfter(like))
              || (next.likes == previous.likes - 1 && exists(like) && !existsAfter(like))))
          || (next.diff(previous).affectedKeys().hasOnly(['comments','lastComment'])
            && next.comments == previous.comments + 1
            && next.lastComment.matches('^[A-Za-z0-9]{20}$')
            && !exists(commentPath(uid, next.lastComment))
            && getAfter(commentPath(uid, next.lastComment)).data.author == request.auth.uid)
        );
    }
    match /gallerySocial/{uid} {
      allow get: if socialAccess(uid);
      allow create, update: if socialAccess(uid) && validTotals(uid, request.resource.data);
      match /{kind}/{actor} {
        allow get: if kind in ['views','likes'] && owner(actor) && socialAccess(uid);
        allow create: if kind in ['views','likes'] && owner(actor) && socialAccess(uid)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time && delta(uid, kind, 1);
        allow delete: if kind == 'likes' && owner(actor) && socialAccess(uid) && delta(uid, kind, -1);
      }
      match /messages/{id} {
        allow read: if socialAccess(uid);
        allow create: if socialAccess(uid)
          && request.resource.data.keys().hasOnly(['author','name','text','createdAt'])
          && request.resource.data.author == request.auth.uid
          && request.resource.data.name == request.auth.token.get('name', 'Pengunjung')
          && request.resource.data.name is string && request.resource.data.name.size() <= 256
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && delta(uid, 'comments', 1) && getAfter(statsPath(uid)).data.lastComment == id;
      }
    }
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['slug'])
        && (request.resource.data.slug == null ||
          (validSlug(request.resource.data.slug)
          && getAfter(/databases/$(database)/documents/galleries/$(request.resource.data.slug)).data.uid == uid))
        && (resource == null || resource.data.slug == null ||
          resource.data.slug == request.resource.data.slug ||
          !existsAfter(/databases/$(database)/documents/galleries/$(resource.data.slug)));
      match /photos/{photo} {
        allow delete: if owner(uid)
          && getAfter(/databases/$(database)/documents/profiles/$(uid)/trashedPhotos/$(photo)).data.deletedAt == request.time;
        allow read: if owner(uid) || (shared(uid) && resource.data.visibility == 'public');
        allow create: if owner(uid) && validPhoto(request.resource.data)
          && request.resource.data.keys().hasOnly(['region','created','caption','people','date','coverAt','visibility'])
          && (!exists(/databases/$(database)/documents/profiles/$(uid)/trashedPhotos/$(photo))
            || get(/databases/$(database)/documents/profiles/$(uid)/trashedPhotos/$(photo)).data.deletedAt
              + duration.value(30, 'd') > request.time);
        allow update: if owner(uid) && validPhoto(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption','people','date','coverAt','visibility']);
      }
      match /trashedPhotos/{photo} {
        allow read: if owner(uid);
        allow delete: if owner(uid)
          && resource.data.deletedAt + duration.value(30, 'd') > request.time
          && existsAfter(/databases/$(database)/documents/profiles/$(uid)/photos/$(photo));
        allow create: if owner(uid) && validPhoto(request.resource.data)
          && request.resource.data.keys().hasOnly(['region','created','caption','people','date','coverAt','visibility','deletedAt'])
          && request.resource.data.deletedAt == request.time;
      }
    }
    match /galleries/{slug} {
      allow get: if true;
      allow create, update: if validSlug(slug)
        && owner(request.resource.data.uid)
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid'])
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.slug == slug;
      allow delete: if owner(resource.data.uid)
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.slug != slug;
    }
    match /regionRequests/{uid}/places/{place} {
      allow create, update: if owner(uid)
        && place.matches('^(country|province)-[A-Z0-9_-]{2,12}$')
        && request.resource.data.keys().hasOnly(['name', 'requestedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.requestedAt == request.time;
    }
  }
}

